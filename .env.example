# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Generate a new value after rotating an exposed bot token. Never prefix secrets with VITE_.
# TELEGRAM_WEBHOOK_SECRET=generate_with_crypto_randomBytes_32_hex
# Secure only an existing exact callback of this production service; never replaces another bot's URL.
TELEGRAM_WEBHOOK_AUTO_SECURE=true
# Only these verified Telegram account IDs can administer the application (empty denies all).
ADMIN_TELEGRAM_IDS=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Optional independent CSRF signing secret; the bot token is the fallback signing key.
# CSRF_SECRET=generate_with_crypto_randomBytes_32_hex
WEBAPP_URL=https://w4tg.up.railway.app
# Comma-separated exact origins. HTTPS is required in production; no wildcards.
ALLOWED_ORIGINS=https://w4tg.up.railway.app

# Node Environment
NODE_ENV=production

# Error Tracking (Sentry) - Get free tier at https://sentry.io (5k events/month)
# Sign up, create project, copy DSN here
SENTRY_DSN=https://your_key@o1234567.ingest.sentry.io/1234567

# Frontend Sentry DSN (same as above)
VITE_SENTRY_DSN=https://your_key@o1234567.ingest.sentry.io/1234567

# Optional: Stripe (if using payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Database (Railway provides this automatically)
# DATABASE_URL=postgresql://...

# Optional: Google Cloud Storage
# GCS_BUCKET_NAME=your-bucket
# GCS_PROJECT_ID=your-project-id
